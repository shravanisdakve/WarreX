# Gemini API Key – get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Groq API Key (optional fallback) – https://console.groq.com
GROQ_API_KEY="YOUR_GROQ_API_KEY_HERE"

# NVIDIA API Key (optional, primary AI) – https://build.nvidia.com
NVIDIA_API_KEY="YOUR_NVIDIA_API_KEY_HERE"

# App URL
APP_URL="http://localhost:3000"

# ── Supabase (PostgreSQL) ──────────────────────────────────────────
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Frontend Supabase (exposed to browser via VITE_ prefix)
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# ── Firebase Auth ──────────────────────────────────────────────────
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_APP_ID"

# Firebase Admin (Backend – for verifying tokens)
FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@YOUR_PROJECT.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# Email (optional – leave blank for mock/console logging)
# EMAIL_USER=""
# EMAIL_PASS=""

# ── Backend Runtime Configuration ──────────────────────────────────
PORT=3000
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Rate Limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=100

# File Uploads
ALLOWED_MIME_TYPES="image/jpeg,image/png,image/webp,image/gif,image/bmp,application/pdf"
MAX_FILE_SIZE_BYTES=5242880

# Cron & Notifications
CRON_SCHEDULE="*/5 * * * *"
REMINDER_WINDOW_1_DAYS=30
REMINDER_WINDOW_2_DAYS=7

# Demo Mode (set to 'true' to enable /api/seed-demo endpoint)
DEMO_MODE=false
